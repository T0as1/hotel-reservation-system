<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.ReceptionistDashboardController"
            prefWidth="1100" prefHeight="700">
    <top>
        <HBox styleClass="nav-bar" alignment="CENTER_LEFT" spacing="16">
            <padding><Insets left="8" right="8"/></padding>
            <Label text="&#127770; AURORA STAYS" styleClass="nav-brand"/>
            <Label text="&#8226;" styleClass="nav-dot"/>
            <Label text="RECEPTION" styleClass="nav-section"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="navUsername" styleClass="nav-user"/>
            <Button text="Sign Out" styleClass="nav-logout-btn" onAction="#handleLogout"/>
        </HBox>
    </top>
    <left>
        <VBox styleClass="sidebar">
            <VBox styleClass="sidebar-brand" alignment="CENTER" spacing="4">
                <Label text="&#127770;" style="-fx-font-size:30px;"/>
                <Label text="AURORA" style="-fx-font-size:13px;-fx-font-weight:bold;-fx-text-fill:#00E5A8;"/>
                <Label text="STAYS" style="-fx-font-size:9px;-fx-text-fill:#A78BFA;"/>
            </VBox>
            <Region styleClass="sidebar-divider" maxWidth="1.7976931348623157E308"/>
            <Label text="RECEPTION" styleClass="sidebar-section"/>
            <Button fx:id="btnOverview" text="&#128202;  Overview"   styleClass="sidebar-btn-active" onAction="#showOverview"/>
            <Button fx:id="btnCheckIn"  text="&#9989;  Check-In"     styleClass="sidebar-btn" onAction="#showCheckIn"/>
            <Button fx:id="btnCheckOut" text="&#127937;  Check-Out"  styleClass="sidebar-btn" onAction="#showCheckOut"/>
            <Button fx:id="btnGuests"   text="&#128101;  All Guests" styleClass="sidebar-btn" onAction="#showGuests"/>
            <Button fx:id="btnChat"     text="&#128172;  Live Chat"  styleClass="sidebar-btn" onAction="#showChat"/>
        </VBox>
    </left>
    <center>
        <StackPane fx:id="contentArea" styleClass="main-content">

            <!-- OVERVIEW -->
            <VBox fx:id="overviewPage" spacing="20" visible="true" managed="true">
                <Label text="Reception Overview" styleClass="page-title"/>
                <HBox spacing="16">
                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="8">
                        <Label text="&#9203;" styleClass="stat-icon"/>
                        <Label fx:id="pendingCount" text="0" styleClass="stat-value"/>
                        <Label text="PENDING CHECK-INS" styleClass="stat-label"/>
                    </VBox>
                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="8">
                        <Label text="&#127968;" styleClass="stat-icon"/>
                        <Label fx:id="checkedInCount" text="0" styleClass="stat-value"/>
                        <Label text="CHECKED IN" styleClass="stat-label"/>
                    </VBox>
                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="8">
                        <Label text="&#128716;" styleClass="stat-icon"/>
                        <Label fx:id="availableCount" text="0" styleClass="stat-value"/>
                        <Label text="ROOMS AVAILABLE" styleClass="stat-label"/>
                    </VBox>
                </HBox>
                <VBox styleClass="content-card" VBox.vgrow="ALWAYS">
                    <HBox styleClass="card-header"><Label text="Today's Activity" styleClass="card-title"/></HBox>
                    <TableView fx:id="overviewTable" styleClass="table-view" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="oId"     text="ID"        prefWidth="60"/>
                            <TableColumn fx:id="oGuest"  text="Guest"     prefWidth="140"/>
                            <TableColumn fx:id="oRoom"   text="Room"      prefWidth="90"/>
                            <TableColumn fx:id="oIn"     text="Check-In"  prefWidth="120"/>
                            <TableColumn fx:id="oOut"    text="Check-Out" prefWidth="120"/>
                            <TableColumn fx:id="oStatus" text="Status"    prefWidth="130"/>
                        </columns>
                    </TableView>
                </VBox>
            </VBox>

            <!-- CHECK-IN -->
            <VBox fx:id="checkInPage" spacing="20" visible="false" managed="false">
                <Label text="Guest Check-In" styleClass="page-title"/>
                <VBox styleClass="form-card" maxWidth="520" spacing="16">
                    <Label text="SELECT RESERVATION" styleClass="field-label"/>
                    <ComboBox fx:id="checkInBox" promptText="Choose a confirmed reservation..."
                              styleClass="combo-field" maxWidth="1.7976931348623157E308" prefHeight="46"/>
                    <Label fx:id="checkInMsg" managed="false" visible="false" wrapText="true"/>
                    <Button text="&#9989;  Confirm Check-In" styleClass="primary-btn" prefHeight="50"
                            maxWidth="1.7976931348623157E308" onAction="#processCheckIn"/>
                </VBox>
            </VBox>

            <!-- CHECK-OUT -->
            <VBox fx:id="checkOutPage" spacing="20" visible="false" managed="false">
                <Label text="Guest Check-Out" styleClass="page-title"/>
                <VBox styleClass="form-card" maxWidth="520" spacing="16">
                    <Label text="SELECT RESERVATION" styleClass="field-label"/>
                    <ComboBox fx:id="checkOutBox" promptText="Choose a checked-in reservation..."
                              styleClass="combo-field" maxWidth="1.7976931348623157E308" prefHeight="46"/>
                    <Label fx:id="checkOutMsg" managed="false" visible="false" wrapText="true"/>
                    <Button text="&#127937;  Confirm Check-Out" styleClass="primary-btn" prefHeight="50"
                            maxWidth="1.7976931348623157E308" onAction="#processCheckOut"/>
                </VBox>
            </VBox>

            <!-- GUESTS -->
            <VBox fx:id="guestsPage" spacing="16" visible="false" managed="false">
                <Label text="All Guests" styleClass="page-title"/>
                <VBox styleClass="content-card" VBox.vgrow="ALWAYS">
                    <HBox styleClass="card-header"><Label text="Registered Guests" styleClass="card-title"/></HBox>
                    <TableView fx:id="guestsTable" styleClass="table-view" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="gUser"    text="Username" prefWidth="150"/>
                            <TableColumn fx:id="gBalance" text="Balance"  prefWidth="110"/>
                            <TableColumn fx:id="gGender"  text="Gender"   prefWidth="100"/>
                            <TableColumn fx:id="gAddress" text="Address"  prefWidth="280"/>
                        </columns>
                    </TableView>
                </VBox>
            </VBox>

            <!-- CHAT -->
            <VBox fx:id="chatPage" spacing="0" visible="false" managed="false">
                <Label text="Live Chat" styleClass="page-title" style="-fx-padding:0 0 14 0;"/>
                <HBox spacing="16" VBox.vgrow="ALWAYS">
                    <VBox styleClass="content-card" HBox.hgrow="ALWAYS" spacing="0">
                        <HBox styleClass="card-header" alignment="CENTER_LEFT" spacing="12">
                            <Label text="Messages from Guests" styleClass="card-title" HBox.hgrow="ALWAYS"/>
                            <Label fx:id="chatStatus" text="&#9679; Server Off" style="-fx-text-fill:#F87171;-fx-font-size:12px;-fx-font-weight:bold;"/>
                        </HBox>
                        <ScrollPane fx:id="chatScroll" fitToWidth="true" styleClass="scroll-pane" VBox.vgrow="ALWAYS">
                            <VBox fx:id="chatBox" spacing="10" style="-fx-padding:16;"/>
                        </ScrollPane>
                        <HBox style="-fx-padding:12 16;-fx-border-color:#1A3060 transparent transparent transparent;-fx-border-width:1 0 0 0;" spacing="12" alignment="CENTER">
                            <TextField fx:id="replyField" styleClass="chat-input" promptText="Type a reply..."
                                       HBox.hgrow="ALWAYS" prefHeight="40" onAction="#sendReply"/>
                            <Button text="Reply" styleClass="chat-send-btn" onAction="#sendReply" prefHeight="40"/>
                        </HBox>
                    </VBox>
                </HBox>
            </VBox>

        </StackPane>
    </center>
</BorderPane>
