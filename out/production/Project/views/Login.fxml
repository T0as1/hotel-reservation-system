<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.LoginController"
            prefWidth="1080" prefHeight="680" styleClass="auth-root">

    <left>
        <VBox styleClass="left-panel" alignment="CENTER" spacing="20" prefWidth="430">
            <padding><Insets top="50" bottom="50" left="48" right="48"/></padding>

            <Label fx:id="logoLabel" text="&#127770;" styleClass="hotel-icon" alignment="CENTER"/>

            <VBox alignment="CENTER" spacing="8">
                <Label text="VESPERA" styleClass="brand-name" alignment="CENTER" textAlignment="CENTER" maxWidth="Infinity"/>
                <Region styleClass="brand-line" prefHeight="2" maxWidth="170"/>
                <Label text="TWILIGHT  ✦  RESORTS" styleClass="brand-sub" alignment="CENTER" textAlignment="CENTER" maxWidth="Infinity"/>
            </VBox>

            <Region prefHeight="6"/>

            <VBox spacing="14" alignment="CENTER_LEFT" maxWidth="280">
                <HBox spacing="14" alignment="CENTER_LEFT">
                    <Label text="&#128737;" styleClass="feature-icon"/>
                    <Label text="Curated boutique rooms" styleClass="feature-item"/>
                </HBox>
                <HBox spacing="14" alignment="CENTER_LEFT">
                    <Label text="&#127775;" styleClass="feature-icon"/>
                    <Label text="24/7 concierge support" styleClass="feature-item"/>
                </HBox>
                <HBox spacing="14" alignment="CENTER_LEFT">
                    <Label text="&#9889;" styleClass="feature-icon"/>
                    <Label text="Instant booking &amp; checkout" styleClass="feature-item"/>
                </HBox>
                <HBox spacing="14" alignment="CENTER_LEFT">
                    <Label text="&#128172;" styleClass="feature-icon"/>
                    <Label text="Live chat with reception" styleClass="feature-item"/>
                </HBox>
            </VBox>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="rootStack" styleClass="right-panel">
            <VBox fx:id="formBox" alignment="CENTER" spacing="20" maxWidth="460">
                <padding><Insets top="48" bottom="48" left="48" right="48"/></padding>
                <Region prefHeight="0" VBox.vgrow="ALWAYS"/>
                <VBox spacing="6" alignment="CENTER">
                    <Label text="Welcome back" styleClass="form-title"/>
                    <Label text="Sign in to continue your journey" styleClass="form-subtitle"/>
                </VBox>

                <Label fx:id="messageLabel" styleClass="error-label" wrapText="true" managed="false" visible="false" maxWidth="Infinity"/>
                <Region fx:id="messageSpace" prefHeight="12" managed="false" visible="false"/>

                <VBox spacing="18">
                    <VBox spacing="6">
                        <Label text="USERNAME" styleClass="field-label"/>
                        <TextField fx:id="usernameField" promptText="Enter your username" styleClass="input-field" prefHeight="46"/>
                    </VBox>
                    <VBox spacing="6">
                        <Label text="PASSWORD" styleClass="field-label"/>
                        <PasswordField fx:id="passwordField" promptText="Enter your password" styleClass="input-field" prefHeight="46"/>
                    </VBox>
                    <Button fx:id="loginBtn" text="SIGN IN" styleClass="primary-btn"
                            prefHeight="50" maxWidth="Infinity" onAction="#handleLogin" defaultButton="true"/>
                </VBox>

                <HBox alignment="CENTER" spacing="8">
                    <Label text="New here?" styleClass="form-subtitle"/>
                    <Button text="Create an account" onAction="#goToRegister" styleClass="link-btn-alt"/>
                </HBox>
                <Region prefHeight="0" VBox.vgrow="ALWAYS"/>
            </VBox>
        </StackPane>
    </center>
</BorderPane>
