<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.RegisterController"
            prefWidth="1080" prefHeight="720" styleClass="auth-root">
    <left>
        <VBox styleClass="left-panel" alignment="CENTER" spacing="18"             prefWidth="430">
            <padding><Insets top="50" bottom="50" left="46" right="46"/></padding>

            <Label text="&#127770;" styleClass="hotel-icon" alignment="CENTER"/>

            <VBox alignment="CENTER" spacing="8">
                <Label text="VESPERA" styleClass="brand-name" alignment="CENTER" textAlignment="CENTER" maxWidth="Infinity"/>
                <Region styleClass="brand-line" prefHeight="2" maxWidth="170"/>
                <Label text="JOIN THE  ✦  CLUB" styleClass="brand-sub" alignment="CENTER" textAlignment="CENTER" maxWidth="Infinity"/>
            </VBox>

            <Region prefHeight="6"/>

            <VBox spacing="12" alignment="CENTER_LEFT" maxWidth="280">
                <Label text="WHAT YOU GET" styleClass="field-label" alignment="CENTER" textAlignment="CENTER" maxWidth="Infinity"/>
                <HBox spacing="14" alignment="CENTER_LEFT">
                    <Label text="&#127881;" styleClass="feature-icon"/>
                    <Label text="\$2,000 welcome credit" styleClass="feature-item"/>
                </HBox>
                <HBox spacing="14" alignment="CENTER_LEFT">
                    <Label text="&#128274;" styleClass="feature-icon"/>
                    <Label text="Secure account &amp; data" styleClass="feature-item"/>
                </HBox>
                <HBox spacing="14" alignment="CENTER_LEFT">
                    <Label text="&#9203;" styleClass="feature-icon"/>
                    <Label text="Book in seconds" styleClass="feature-item"/>
                </HBox>
                <HBox spacing="14" alignment="CENTER_LEFT">
                    <Label text="&#127968;" styleClass="feature-icon"/>
                    <Label text="Personalised stays" styleClass="feature-item"/>
                </HBox>
            </VBox>
        </VBox>
    </left>
    <center>
        <StackPane fx:id="rootStack" styleClass="right-panel">
            <ScrollPane fitToWidth="true" styleClass="scroll-pane" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
                <VBox fx:id="formBox" styleClass="right-panel" alignment="TOP_CENTER" spacing="0" minWidth="540">
                    <padding><Insets top="44" bottom="44" left="48" right="48"/></padding>
                    <VBox alignment="CENTER" spacing="6">
                        <Label text="Create your account" styleClass="form-title"/>
                        <Label text="A few details and you're in" styleClass="form-subtitle"/>
                    </VBox>
                    <Region prefHeight="22"/>
                    <Label fx:id="messageLabel" styleClass="error-label" wrapText="true" maxWidth="Infinity" managed="false" visible="false"/>
                    <Region fx:id="messageSpace" prefHeight="12" managed="false" visible="false"/>
                    <HBox spacing="16">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="USERNAME" styleClass="field-label"/>
                            <TextField fx:id="usernameField" promptText="Letters and digits only" styleClass="input-field" prefHeight="44"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="PASSWORD" styleClass="field-label"/>
                            <PasswordField fx:id="passwordField" promptText="Min. 5 characters" styleClass="input-field" prefHeight="44"/>
                        </VBox>
                    </HBox>
                    <Region prefHeight="14"/>
                    <HBox spacing="16">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="DATE OF BIRTH" styleClass="field-label"/>
                            <TextField fx:id="dobField" promptText="YYYY-MM-DD" styleClass="input-field" prefHeight="44"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="GENDER" styleClass="field-label"/>
                            <ComboBox fx:id="genderBox" promptText="Select gender" styleClass="combo-field" prefHeight="44" maxWidth="1.7976931348623157E308"/>
                        </VBox>
                    </HBox>
                    <Region prefHeight="14"/>
                    <VBox spacing="6">
                        <Label text="ADDRESS" styleClass="field-label"/>
                        <TextField fx:id="addressField" promptText="Your full address" styleClass="input-field" prefHeight="44"/>
                    </VBox>
                    <Region prefHeight="14"/>
                    <VBox spacing="6">
                        <Label text="ROOM PREFERENCES (OPTIONAL)" styleClass="field-label"/>
                        <TextField fx:id="preferencesField" promptText="e.g. High floor, ocean view, quiet room" styleClass="input-field" prefHeight="44"/>
                    </VBox>
                    <Region prefHeight="28"/>
                    <Button fx:id="registerBtn" text="CREATE MY ACCOUNT" styleClass="primary-btn" prefHeight="52" maxWidth="1.7976931348623157E308" onAction="#handleRegister" defaultButton="true"/>
                    <Region prefHeight="18"/>
                    <HBox alignment="CENTER" spacing="6">
                        <Label text="Already a member?" styleClass="link-text"/>
                        <Button text="Sign in here" styleClass="link-btn" onAction="#goToLogin"/>
                    </HBox>
                </VBox>
            </ScrollPane>
        </StackPane>
    </center>
</BorderPane>
